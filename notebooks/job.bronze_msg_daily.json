{
  "name": "bronze_msg_daily",
  "description": "Daily age-decrypt + Auto Loader ingest of the msg export into the bronze layer. Append-only; re-runnable within the 7-day source retention window.",
  "max_concurrent_runs": 1,
  "timeout_seconds": 3600,
  "tags": {
    "layer": "bronze",
    "source": "shira-digest-backups"
  },
  "schedule": {
    "quartz_cron_expression": "0 30 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "email_notifications": {
    "on_failure": ["shira984@gmail.com"],
    "no_alert_for_skipped_runs": false
  },
  "tasks": [
    {
      "task_key": "ingest_bronze_msg",
      "notebook_task": {
        "notebook_path": "/Workspace/Repos/data-engineering/notebooks/bronze_msg_daily",
        "source": "WORKSPACE",
        "base_parameters": {
          "catalog": "main",
          "schema": "bronze",
          "table": "msg",
          "volume": "landing",
          "s3_root": "s3://shira-digest-backups/analytics",
          "secret_scope": "digest-backups",
          "secret_key": "age-identity",
          "age_mode": "identity",
          "lookback_days": "7",
          "merge_key": "_row_hash",
          "fail_on_missing_today": "true"
        }
      },
      "job_cluster_key": "bronze_ingest",
      "max_retries": 2,
      "min_retry_interval_millis": 300000,
      "retry_on_timeout": true
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "bronze_ingest",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 1,
        "data_security_mode": "SINGLE_USER",
        "runtime_engine": "PHOTON"
      }
    }
  ]
}
